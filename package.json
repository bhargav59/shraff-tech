{
  "name": "shraff-tech-ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-cost multi-language client-side WebAssembly IDE and snippet sharing platform for shraff.tech",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@upstash/ratelimit": "^2.2.2",
    "@upstash/redis": "^1.41.1",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.40.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
